[sub_resource type="GDScript" id="GDScript_mqtpj"]
script/source = "class_name DreamFilter
extends CanvasLayer

@export_file(\"*.gdshader\") var shader_path: String = \"res://shaders/dream_filter.gdshader\"
@export var blur_amount: float = 2.0
@export var brightness: float = 1.2
@export var saturation: float = 0.7
@export var tint_color: Color = Color(0.9, 0.85, 1.0, 1.0)
@export var vignette_strength: float = 0.3
@export var enabled: bool = false

var color_rect: ColorRect
var shader_material: ShaderMaterial

func _ready():
	# Create the ColorRect that covers the screen
	color_rect = ColorRect.new()
	color_rect.material = ShaderMaterial.new()
	shader_material = color_rect.material
	
	# Load the shader
	if FileAccess.file_exists(shader_path):
		var shader = load(shader_path)
		shader_material.shader = shader
		print(\"Dream filter loaded successfully!\")
	else:
		push_error(\"Dream Filter: Shader not found at path: \" + shader_path)
		push_error(\"Please set the correct shader path in the Inspector or place dream_filter.gdshader at: \" + shader_path)
		return
	
	# Set up the ColorRect to cover the whole screen
	color_rect.set_anchors_preset(Control.PRESET_FULL_RECT)
	color_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	
	add_child(color_rect)
	
	# Apply initial settings
	update_shader_params()
	set_enabled(enabled)

func update_shader_params():
	if shader_material:
		shader_material.set_shader_parameter(\"blur_amount\", blur_amount)
		shader_material.set_shader_parameter(\"brightness\", brightness)
		shader_material.set_shader_parameter(\"saturation\", saturation)
		shader_material.set_shader_parameter(\"tint_color\", tint_color)
		shader_material.set_shader_parameter(\"vignette_strength\", vignette_strength)

func set_enabled(value: bool):
	enabled = value
	if color_rect:
		color_rect.visible = enabled

func fade_in(duration: float = 1.0):
	\"\"\"Fade the dream effect in over time\"\"\"
	enabled = true
	color_rect.visible = true
	color_rect.modulate.a = 0.0
	
	var tween = create_tween()
	tween.tween_property(color_rect, \"modulate:a\", 1.0, duration)

func fade_out(duration: float = 1.0):
	\"\"\"Fade the dream effect out over time\"\"\"
	var tween = create_tween()
	tween.tween_property(color_rect, \"modulate:a\", 0.0, duration)
	tween.tween_callback(func(): set_enabled(false))
"

