[sub_resource type="GDScript" id="GDScript_0mjas"]
resource_name = "t"
script/source = "extends Sprite2D


@export var teleport_position: Vector2 = Vector2(500, 100)

var player_nearby: bool = false

func _ready():
	connect(\"body_entered\", _on_body_entered)
	connect(\"body_exited\", _on_body_exited)

func _on_body_entered(body):
	if body.name == \"Player\":
		player_nearby = true
		print(\"Player near tree\")

func _on_body_exited(body):
	if body.name == \"Player\":
		player_nearby = false
		print(\"Player left tree\")

func _input(event):
	if event.is_action_pressed(\"interact\") and player_nearby:
		climb_tree()

func climb_tree():
	var player = get_tree().get_first_node_in_group(\"player\")
	if player:
		player.global_position = teleport_position
		print(\"Climbing tree!\")
"

