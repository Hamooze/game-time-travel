[node name="Label" type="Label" parent="Player2/Camera2D/Papers/Paper2"]
offset_left = -18.5
offset_top = -29.0
offset_right = 797.5
offset_bottom = 202.0
scale = Vector2(0.18, 0.18)
text = "Day 49.
Everything looks the same 
but feels hollow. 
Empty buildings that no one 
built. Echoes of a world that 
never was.
The lab is close, just 2 miles 
north of here.
 The machine should be there.
"

