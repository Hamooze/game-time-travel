[node name="Label" type="Label" parent="Player2/Camera2D/Papers/Paper4"]
offset_left = -18.5
offset_top = -29.0
offset_right = 797.5
offset_bottom = 202.0
scale = Vector2(0.17, 0.17)
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Day 54.
I'm inside. There's a helper 
robot here, AEON, designed
to help around the lab, but 
it's dormant without 
activation protocols.
The safe is in the main 
research hall, row 6, it has the
activation manual and other
important document. I'm 
running out of time. The
 instability is tearing me apart, 
but I can do this.
"

